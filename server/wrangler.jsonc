{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "server",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "assets": {
    "directory": "../client",
    "binding": "ASSETS",
  },
  "build": {
    "command": "pnpm esbuild ../client/script.ts --bundle --outfile=../client/dist/script.js",
    "watch_dir": ["../client/script.ts", "../shared"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "drawcircle-db",
      "database_id": "863bb6d3-dbb8-4867-99e6-371620c042aa",
      "migrations_dir": "migrations",
    },
  ],
  // "compatibility_flags": [
