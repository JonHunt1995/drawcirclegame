{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "drawcirclegame",
  "main": "server/src/index.tsx",
  "compatibility_date": "2026-09-08",
  "assets": {
    "directory": "client",
    "binding": "ASSETS"
  },
  "build": {
    "command": "pnpm -w run build",
    "watch_dir": ["client/script.ts", "client/gameshare.ts", "client/share.ts", "shared"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "drawcircle-db",
      "database_id": "863bb6d3-dbb8-4867-99e6-371620c042aa",
      "preview_database_id": "371f5e9a-d605-4306-a1d3-96180f59c80e",
      "migrations_dir": "server/migrations"
    }
  ],
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "drawcircle-db-preview",
        "database_id": "371f5e9a-d605-4306-a1d3-96180f59c80e",
        "migrations_dir": "server/migrations"
      }
    ]
  }
}
