{
  "name": "drawcirclegame",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "node scripts/isolate-preview-db.js && esbuild client/script.ts client/gameshare.ts --bundle --outdir=client/dist",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:preview": "wrangler d1 migrations apply DB --remote --preview",
    "migrate:remote": "wrangler d1 migrations apply DB --remote",
    "predev": "pnpm run migrate:local",
    "dev": "wrangler dev",
    "predeploy": "node scripts/isolate-preview-db.js && pnpm run migrate:remote",
    "deploy": "wrangler deploy --minify",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@cloudflare/workers-types": "^5.20260928.1",
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  }
}
